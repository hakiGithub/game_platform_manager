# 平台工具镜像（ADR-0021 决策 6）
# 用途：宿主机缺原生下载/解压工具时，补丁安装流程借 `docker run --rm` 容器内预装工具代劳，
#       宿主机零改动、无需提权。运行时除首次 pull 外零网络依赖。
# 构建/推送（与 gfw-302 同仓库 haki_hub，手动构建）：
#   docker build -t registry.cn-shenzhen.aliyuncs.com/haki_hub/platform-tools:latest -f docker/Dockerfile.platform-tools .
#   docker push registry.cn-shenzhen.aliyuncs.com/haki_hub/platform-tools:latest
FROM alpine:3.20

# bsdtar(libarchive-tools) 覆盖 tar.gz/tar.bz2/tar.xz/zip 单命令解压；7zip 补 7z/rar；
# curl/wget 下载；sha256sum 校验（alpine 自带 busybox 提供）。
# python3 用于 ADR-0027 VPK mission 分析（仅读头部目录树，不依赖第三方 VPK 库）。
# VpkToolingAnalyzer 固定调用 /usr/bin/python3；构建时即验证，避免发布缺运行时的镜像。
# Alpine 3.20 无 unrar 包，7zip 已提供 RAR 读取能力。
RUN apk add --no-cache libarchive-tools 7zip curl wget rsync python3
RUN test -x /usr/bin/python3 && /usr/bin/python3 --version

# 默认入口打印工具清单，便于验证镜像
CMD ["sh", "-c", "test -x /usr/bin/python3 && command -v bsdtar 7zz 7z curl wget rsync sha256sum"]
